#!/bin/bash
cd /opt/karenseir/app || exit 1
B=7f29e33
git cat-file -e $B 2>/dev/null || git fetch -q --depth=300 origin feat/inner-redesign-on-production
git diff --stat=100 $B HEAD > /root/k2.stat
git diff $B HEAD > /root/k2.patch
git diff $B HEAD -- . ':!docs' ':!deploy/*.md' ':!*.md' > /root/k2.code.patch
clear
echo "vs $B: $(git diff --shortstat $B HEAD)"
echo "patch lines: $(wc -l < /root/k2.patch)  code-only lines: $(wc -l < /root/k2.code.patch)"
echo "server log since common history:"; git log --oneline -12 | cat
echo "== stat (files) =="; sed 's/|.*|/|/' /root/k2.stat | awk '{print $1, $3}' | head -40
