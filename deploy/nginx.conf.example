# Replace hostnames and certificate paths with authorized production values.
# This template intentionally does not provision or claim a TLS certificate.
limit_req_zone $binary_remote_addr zone=karenseir_api:10m rate=20r/s;
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_types application/json application/javascript text/css text/plain image/svg+xml;

server {
    listen 80;
    server_name travel.example api.travel.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name travel.example;

    ssl_certificate /etc/letsencrypt/live/travel.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/travel.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;

    location / {
        proxy_pass http://web:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Correlation-ID $http_x_correlation_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

server {
    listen 443 ssl http2;
    server_name api.travel.example;

    ssl_certificate /etc/letsencrypt/live/api.travel.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.travel.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    client_max_body_size 2m;
    location / {
        limit_req zone=karenseir_api burst=40 nodelay;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Correlation-ID $http_x_correlation_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
