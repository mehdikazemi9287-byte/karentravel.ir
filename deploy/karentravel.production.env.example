# Non-secret canonical settings, to apply together after DNS/TLS provisioning (deploy/karenseir-https.sh sets the HTTPS ones).
ENVIRONMENT=production
DEMO_MODE=false
PUBLIC_WEB_URL=https://karentravel.ir
NEXT_PUBLIC_SITE_URL=https://karentravel.ir
# Path-mounted API on the same host (nginx location /api/); server-side fetches (sitemap) need the absolute URL.
NEXT_PUBLIC_API_URL=https://karentravel.ir/api
CORS_ORIGINS=https://karentravel.ir,https://www.karentravel.ir
ALLOW_HTTP_PREVIEW=0
ALLOW_HTTP_ORIGIN_PREVIEW=0
ZARINPAL_CALLBACK_URL=https://karentravel.ir/api/payments/zarinpal/callback
# Keep providers disabled until contracts/credentials and sandbox acceptance are complete.
ZARINPAL_MODE=disabled
# Never set PAYMENT_PROVIDER=sandbox here: the sandbox gateway refuses to start in production.
RESERVATION_FUNDED_HOLD_MINUTES=1440
GRS_MODE=disabled
FLIGHT_PROVIDER_MODE=disabled
# Optional per-purpose signing keys (M-5). Unset = derived from JWT_SECRET with HKDF, so
# nothing has to change on upgrade. Set each to its own 32+ random characters (or *_FILE) to
# fully decouple them. The compose file must pass any you set through to the api service.
# ACCESS_TOKEN_SECRET=        # access JWTs (unset = JWT_SECRET itself; changing it logs everyone out)
# MFA_TICKET_SECRET=          # 2FA login ticket
# PAYMENT_STATE_SECRET=       # payment callback state
# VOUCHER_QR_SECRET=          # voucher QR codes
# Accept values signed with the old shared key (in-flight payments, printed vouchers).
# Set to 0 once vouchers issued before the upgrade have expired.
# SIGNING_LEGACY_FALLBACK=1
# Mount private secret files; do not also define the corresponding plain variables.
# JWT_SECRET_FILE=/run/secrets/karenseir_jwt_secret
# KAVENEGAR_API_KEY_FILE=/run/secrets/karenseir_kavenegar_key
# ZARINPAL_MERCHANT_ID_FILE=/run/secrets/karenseir_zarinpal_merchant
