+/*
+  Karen Travel — Search results page in the Google Stitch 2026-11 design (Desktop/02 Flight Results, Mobile/02).
+  Scope: the standalone /search/results page only (.search-results-page:not(.embedded)).
+  Markup, data, prices and booking logic are unchanged — only presentation. Rollback: remove the import in UnifiedSearchView.tsx.
+*/
+.search-results-page:not(.embedded){--sr-bg:#fdf6f0;--sr-card:#fff;--sr-line:#f0e2d8;--sr-plum:#2a1530;--sr-muted:#7f6d79;--sr-red:#a8321d;--sr-red-hover:#8f2716;--sr-coral:#ef5b3d;--sr-sun:#fbe9c6;background:transparent;color:var(--sr-plum);max-width:1280px;margin:0 auto;padding:20px 24px 64px;min-height:100vh}
+.search-results-page:not(.embedded) .results-breadcrumb{font-size:13px;color:var(--sr-muted);margin-bottom:12px}
+.search-results-page:not(.embedded) .results-breadcrumb .brand-mark{background:var(--sr-coral);color:#fff;border-radius:10px}
+
+/* summary bar (Stitch: route chip row) */
+.search-results-page:not(.embedded) .results-hero{background:var(--sr-card);border:1px solid var(--sr-line);border-radius:24px;padding:18px 24px;box-shadow:0 1px 8px rgba(42,21,48,.05);display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
+.search-results-page:not(.embedded) .results-hero h1{font-size:clamp(20px,2.2vw,28px);font-weight:800;letter-spacing:-.5px;margin:2px 0}
+.search-results-page:not(.embedded) .results-hero p{color:var(--sr-muted);font-size:13px;margin:0}
+.search-results-page:not(.embedded) .results-hero .eyebrow{color:var(--sr-coral);font-size:12px;font-weight:800}
+.search-results-page:not(.embedded) .results-hero .button{border-radius:999px}
+
+/* layout: sticky filter card on the right, results on the left */
+.search-results-page:not(.embedded) .results-layout{grid-template-columns:300px 1fr;gap:28px;padding-top:24px}
+.search-results-page:not(.embedded) .results-filters{background:var(--sr-card);border:1px solid var(--sr-line);border-radius:24px;padding:20px;top:96px;box-shadow:0 1px 8px rgba(42,21,48,.04)}
+.search-results-page:not(.embedded) .results-filters header{display:flex;justify-content:space-between;align-items:center;padding-bottom:12px;margin-bottom:8px;border-bottom:1px solid var(--sr-line)}
+.search-results-page:not(.embedded) .results-filters header strong{font-size:16px;font-weight:800}
+.search-results-page:not(.embedded) .results-filters header button{background:none;border:0;color:var(--sr-coral);font-size:12px;font-weight:700;cursor:pointer}
+.search-results-page:not(.embedded) .results-filters label{font-size:13px;font-weight:700;color:var(--sr-plum)}
+.search-results-page:not(.embedded) .results-filters :is(input:not([type=checkbox]),select){border:1px solid var(--sr-line);border-radius:14px;background:#fffaf4;padding:9px 12px}
+.search-results-page:not(.embedded) .results-filters input[type=checkbox]{accent-color:var(--sr-red)}
+
+/* toolbar / sort */
+.search-results-page:not(.embedded) .results-toolbar{background:var(--sr-card);border:1px solid var(--sr-line);border-radius:20px;padding:10px 16px}
+.search-results-page:not(.embedded) .results-toolbar select{border-radius:999px;border:1px solid var(--sr-line);padding:6px 14px;background:#fffaf4}
+
+/* result cards */
+.search-results-page:not(.embedded) .search-results-list{display:flex;flex-direction:column;gap:18px}
+.search-results-page:not(.embedded) .result-card{background:var(--sr-card);border:1px solid var(--sr-line);border-radius:24px;padding:22px 24px;grid-template-columns:1fr 250px;box-shadow:0 1px 6px rgba(42,21,48,.04)}
+.search-results-page:not(.embedded) .result-card:hover{border-color:#e9b9a9;box-shadow:0 18px 45px rgba(42,21,48,.10)}
+.search-results-page:not(.embedded) .result-type{display:inline-block;background:#f5eee4;color:var(--sr-plum);border-radius:999px;padding:3px 12px;font-size:11px;font-weight:800}
+.search-results-page:not(.embedded) .result-main h2{font-size:18px;font-weight:800;margin:8px 0 4px}
+.search-results-page:not(.embedded) .result-main h2 a{color:var(--sr-plum);text-decoration:none}
+.search-results-page:not(.embedded) .route-details{font-size:13px;color:var(--sr-muted)}
+.search-results-page:not(.embedded) .route-details>span{font-size:22px;font-weight:800;color:var(--sr-plum)}
+.search-results-page:not(.embedded) .trust-chips span,.search-results-page:not(.embedded) .trust-chips li{background:#f5eee4;border-radius:999px;padding:3px 10px;font-size:11px}
+.search-results-page:not(.embedded) .offer-details{font-size:12px;color:var(--sr-muted)}
+.search-results-page:not(.embedded) .result-price{border-right:1px dashed var(--sr-line);padding-right:22px;gap:6px}
+.search-results-page:not(.embedded) .result-price strong,.search-results-page:not(.embedded) .result-price b{font-size:26px;font-weight:900;color:var(--sr-red);letter-spacing:-.5px}
+.search-results-page:not(.embedded) .result-price small{color:var(--sr-muted);font-size:11px}
+.search-results-page:not(.embedded) .result-price .button{width:100%;justify-content:center;border-radius:16px;padding:12px 16px;font-weight:800}
+.search-results-page:not(.embedded) .result-price .button.primary{background:var(--sr-red);color:#fff;border:0}
+.search-results-page:not(.embedded) .result-price .button.primary:hover{background:var(--sr-red-hover)}
+.search-results-page:not(.embedded) .result-price .button.secondary{background:#fffaf4;border:1px solid var(--sr-line);color:var(--sr-plum)}
+.search-results-page:not(.embedded) .compare-check{accent-color:var(--sr-red)}
+
+/* notices, chips, compare dock */
+.search-results-page:not(.embedded) .results-notice{background:var(--sr-sun);color:#6a4708;border:0;border-radius:16px;padding:10px 16px}
+.search-results-page:not(.embedded) .search-shortcuts button{border-radius:999px;border:1px solid var(--sr-line);background:var(--sr-card)}
+.search-results-page:not(.embedded) .compare-dock{background:var(--sr-plum);color:#fff;border-radius:20px}
+.search-results-page:not(.embedded) .compare-dock .button.primary{background:var(--sr-coral);border-radius:999px}
+.search-results-page:not(.embedded) .button.primary{border-radius:999px}
+.search-results-page:not(.embedded) :focus-visible{outline:3px solid #0b8f8b;outline-offset:2px}
+
+@media(max-width:900px){
+  .search-results-page:not(.embedded){padding:12px 12px 80px}
+  .search-results-page:not(.embedded) .results-layout{display:block}
+  .search-results-page:not(.embedded) .results-filters{position:static;border-radius:20px}
+  .search-results-page:not(.embedded) .filters-toggle{border-radius:999px;background:var(--sr-plum);color:#fff;border:0;padding:9px 18px;font-weight:700}
+  .search-results-page:not(.embedded) .result-card{grid-template-columns:1fr;border-radius:20px;padding:16px}
+  .search-results-page:not(.embedded) .result-price{border-right:0;border-top:1px dashed var(--sr-line);padding:12px 0 0}
+}
+
+/* Stitch flight row (airline badge · time · route line · stops) — real offer data only */
+.search-results-page:not(.embedded) .sr-flight-row{display:grid;grid-template-columns:minmax(150px,1.3fr) auto minmax(90px,1fr) auto auto;align-items:center;gap:16px;padding:6px 0 14px;margin-bottom:10px;border-bottom:1px dashed var(--sr-line)}
+.search-results-page:not(.embedded) .sr-airline{display:flex;align-items:center;gap:10px}
+.search-results-page:not(.embedded) .sr-airline b{font-size:15px;font-weight:800}
+.search-results-page:not(.embedded) .sr-airline-badge{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:var(--sr-coral);color:#fff;font-weight:900;font-size:13px}
+.search-results-page:not(.embedded) .sr-leg{display:flex;flex-direction:column;align-items:center}
+.search-results-page:not(.embedded) .sr-leg strong{font-size:24px;font-weight:900;letter-spacing:-.5px;line-height:1.2}
+.search-results-page:not(.embedded) .sr-leg-to strong{font-size:16px}
+.search-results-page:not(.embedded) .sr-leg small{font-size:11px;color:var(--sr-muted)}
+.search-results-page:not(.embedded) .sr-route{display:flex;align-items:center;gap:6px;color:var(--sr-red)}
+.search-results-page:not(.embedded) .sr-route i{flex:1;height:0;border-top:2px dashed #d9c6c0}
+.search-results-page:not(.embedded) .sr-route span{transform:scaleX(-1);font-size:14px}
+.search-results-page:not(.embedded) .sr-stops{font-size:12px;font-weight:800;color:var(--sr-muted);background:#f5eee4;border-radius:999px;padding:3px 10px;white-space:nowrap}
+.search-results-page:not(.embedded) .sr-stops.direct{color:#0b7a55;background:#e3f4ec}
+@media(max-width:900px){.search-results-page:not(.embedded) .sr-flight-row{grid-template-columns:1fr auto 1fr;grid-template-areas:"air air air" "dep route to" "stops stops stops"}.search-results-page:not(.embedded) .sr-airline{grid-area:air}.search-results-page:not(.embedded) .sr-route{grid-area:route;min-width:60px}.search-results-page:not(.embedded) .sr-stops{grid-area:stops;justify-self:center}.search-results-page:not(.embedded) .sr-leg-to{grid-area:to}.search-results-page:not(.embedded) .sr-leg:not(.sr-leg-to){grid-area:dep}}
+
+/* Stitch flight card — styles the real FlightFacts block (no duplicated or invented data) */
+.search-results-page:not(.embedded) .flight-facts{display:grid;grid-template-columns:minmax(150px,auto) 1fr;gap:10px 24px;align-items:center;margin:4px 0 12px}
+.search-results-page:not(.embedded) .flight-carrier{display:flex;align-items:center;gap:10px}
+.search-results-page:not(.embedded) .flight-carrier>span{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;background:var(--sr-coral);color:#fff}
+.search-results-page:not(.embedded) .flight-carrier strong{font-size:15px;font-weight:800;display:block}
+.search-results-page:not(.embedded) .flight-carrier small{font-size:11px;color:var(--sr-muted)}
+.search-results-page:not(.embedded) .flight-route{display:grid;grid-template-columns:minmax(80px,auto) minmax(120px,1fr) minmax(80px,auto);align-items:center;gap:14px}
+.search-results-page:not(.embedded) .flight-route>div:not(.flight-duration){display:flex;flex-direction:column;align-items:center;font-size:12px;color:var(--sr-muted)}
+.search-results-page:not(.embedded) .flight-route>div:not(.flight-duration) b{font-size:13px;color:var(--sr-plum);order:2}
+.search-results-page:not(.embedded) .flight-route time{order:1;font-size:11px;color:var(--sr-muted);text-align:center}
+.search-results-page:not(.embedded) .flight-route time.transport-time{display:flex;flex-direction:column;align-items:center}
+.search-results-page:not(.embedded) .flight-route time.transport-time>:first-child{font-size:24px;font-weight:900;color:var(--sr-plum);letter-spacing:-.5px;line-height:1.2}
+.search-results-page:not(.embedded) .flight-duration{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:11px;color:var(--sr-muted)}
+.search-results-page:not(.embedded) .flight-duration i{display:block;width:100%;border-top:2px dashed #d9c6c0;position:relative}
+.search-results-page:not(.embedded) .flight-duration i::after{content:"✈";position:absolute;top:-11px;left:50%;transform:translateX(-50%) scaleX(-1);color:var(--sr-red);background:var(--sr-card);padding:0 4px;font-size:13px}
+.search-results-page:not(.embedded) .flight-duration small{background:#f5eee4;border-radius:999px;padding:2px 10px;font-weight:800}
+.search-results-page:not(.embedded) .flight-terms{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 0;padding-top:10px;border-top:1px dashed var(--sr-line)}
+.search-results-page:not(.embedded) .flight-terms>div{display:flex;gap:6px;align-items:center;background:transparent;border:0;padding:0;font-size:12px}
+.search-results-page:not(.embedded) .flight-terms dt{color:var(--sr-muted)}
+.search-results-page:not(.embedded) .flight-terms dd{margin:0;font-weight:700;color:var(--sr-plum)}
+.search-results-page:not(.embedded) .flight-rules{grid-column:1/-1;font-size:13px}
+.search-results-page:not(.embedded) .flight-rules summary{color:var(--sr-red);font-weight:800;cursor:pointer}
+.search-results-page:not(.embedded) .result-main>h2{font-size:14px;color:var(--sr-muted);font-weight:700}
+@media(max-width:900px){.search-results-page:not(.embedded) .flight-facts{grid-template-columns:1fr}}
+.search-results-page:not(.embedded) .result-main>p{font-size:12px;color:var(--sr-muted);margin:6px 0}
