From 0f96ae174ab8c6a093ba21680c668ca49fa8a6c0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 18 Nov 2026 10:08:46 +0100
Subject: [PATCH] feat(ui): Stitch login/OTP card, manage-booking and
 confirmation styling

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013GiGkh6Annw6zKCRasH7Lo
---
 app/login/page.tsx                              |   1 +
 components/marketplace/stitch-pages-2026-11.css |  12 ++++++++++++
 .../qa/impl/login-stitch.png                    | Bin 0 -> 75533 bytes
 3 files changed, 13 insertions(+)
 create mode 100644 docs/design/stitch-redesign-2026-11/qa/impl/login-stitch.png

diff --git a/app/login/page.tsx b/app/login/page.tsx
index b0d2a29..73d3a9c 100644
--- a/app/login/page.tsx
+++ b/app/login/page.tsx
@@ -1,4 +1,5 @@
 'use client';
+import '../../components/marketplace/stitch-pages-2026-11.css';
 import { FormEvent, Suspense, useState } from 'react';
 import { useRouter, useSearchParams } from 'next/navigation';
 import Link from 'next/link';
diff --git a/components/marketplace/stitch-pages-2026-11.css b/components/marketplace/stitch-pages-2026-11.css
index 819b0b8..b8cffab 100644
--- a/components/marketplace/stitch-pages-2026-11.css
+++ b/components/marketplace/stitch-pages-2026-11.css
@@ -70,3 +70,15 @@
 .pn[data-area=customer] .pn-stat strong,.pn[data-area=customer] .pn-stat b{font-size:22px;font-weight:900;color:#2a1530}
 .pn[data-area=customer] .pn-btn{border-radius:999px}
 .pn[data-area=customer] .pn-nav a[aria-current=page]{background:#ef5b3d;color:#fff;border-radius:14px}
+
+/* ---------- Login / OTP (Stitch Desktop/14) — ApprovedShell pages ---------- */
+.approved-site.ks-inner>main:has(form .button.primary) .page-hero{text-align:center}
+.approved-site.ks-inner>main .container>form.filters{background:#fff;border:1px solid #f0e2d8;border-radius:28px;padding:24px;box-shadow:0 18px 45px rgba(42,21,48,.08)}
+.approved-site.ks-inner>main .container>form.filters input:not([type=checkbox]){border:1px solid #f0e2d8;border-radius:14px;background:#fffaf4;padding:12px 14px;font-size:16px;letter-spacing:.5px}
+.approved-site.ks-inner>main .container>form.filters input:not([type=checkbox]):focus{border-color:#ef5b3d;outline:none;box-shadow:0 0 0 3px rgba(239,91,61,.15)}
+.approved-site.ks-inner>main .container>form.filters .button.primary{background:#a8321d;color:#fff;border-radius:16px;padding:13px;font-weight:800}
+
+/* ---------- Manage booking & confirmation (Stitch Desktop/11-12) ---------- */
+.journey-page .booking-overview{box-shadow:0 1px 8px rgba(42,21,48,.05)}
+.journey-page .manage-actions :is(a,button){border-radius:18px}
+.journey-page .confirmation-card{background:#fff;border:1px solid #f0e2d8;border-radius:28px;box-shadow:0 18px 45px rgba(42,21,48,.08)}
diff --git a/docs/design/stitch-redesign-2026-11/qa/impl/login-stitch.png b/docs/design/stitch-redesign-2026-11/qa/impl/login-stitch.png
new file mode 100644
