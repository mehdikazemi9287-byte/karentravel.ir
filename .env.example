# Generate unique production secrets; never commit .env.
POSTGRES_PASSWORD=replace-with-strong-password
JWT_SECRET=replace-with-32-or-more-random-characters
# Production secret managers should mount files instead of exposing values:
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# DATABASE_URL_FILE=/run/secrets/database_url
# REDIS_URL_FILE=/run/secrets/redis_url
# PAYMENT_WEBHOOK_SECRET_FILE=/run/secrets/payment_webhook_secret
# NOTIFICATION_WEBHOOK_SECRET_FILE=/run/secrets/notification_webhook_secret
PROVIDER_RESILIENCE_REDIS_URL=redis://redis:6379/0
JWT_ISSUER=karenseir-api
JWT_AUDIENCE=karenseir-web
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://karenseir:replace-with-strong-password@db:5432/karenseir
REDIS_URL=redis://redis:6379/0
# Provision separately; never reuse the API role. Required for cross-tenant outbox polling.
WORKER_DATABASE_URL=postgresql+psycopg://karenseir_worker:replace-with-worker-password@db:5432/karenseir
CORS_ORIGINS=https://your-domain.example
NEXT_PUBLIC_API_URL=https://api.your-domain.example
# External integrations remain disabled until authorized secret-manager references exist.
FLIGHT_PROVIDER_MODE=disabled
HOTEL_PROVIDER_MODE=disabled
TOUR_HOTEL_PROVIDER_MODE=disabled
PAYMENT_PROVIDER_MODE=disabled
OTP_PROVIDER_MODE=disabled
# Sandbox example (never put the secret itself here):
# PAYMENT_PROVIDER_MODE=sandbox
# PAYMENT_PROVIDER_ENDPOINT=https://sandbox.authorized-provider.example
# PAYMENT_PROVIDER_SECRET_REF=vault://karenseir/payment-sandbox
NOTIFICATION_PROVIDER_MODE=disabled
# Explicitly set true only for a labelled demo deployment; never for a real rollout.
DEMO_MODE=false
SMS_PROVIDER_MODE=disabled
PUSH_PROVIDER_MODE=disabled
EMAIL_PROVIDER_MODE=disabled
SUPPLIER_INVENTORY_PROVIDER_MODE=disabled
VOUCHER_ISSUANCE_PROVIDER_MODE=disabled
# Optional provider-specific distributed throttle (requests/minute):
# FLIGHT_PROVIDER_RATE_LIMIT=60
# Invoice issuance is fail-closed in Production until an approved legal policy is configured.
INVOICE_TAX_BPS=
INVOICE_TAX_POLICY_REFERENCE=
