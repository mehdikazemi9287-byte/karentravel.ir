# Generate unique production secrets; never commit .env.
POSTGRES_PASSWORD=replace-with-strong-password
JWT_SECRET=replace-with-32-or-more-random-characters
# Production secret managers should mount files instead of exposing values:
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# DATABASE_URL_FILE=/run/secrets/database_url
# REDIS_URL_FILE=/run/secrets/redis_url
# PAYMENT_WEBHOOK_SECRET_FILE=/run/secrets/payment_webhook_secret
# NOTIFICATION_WEBHOOK_SECRET_FILE=/run/secrets/notification_webhook_secret
PROVIDER_RESILIENCE_REDIS_URL=redis://redis:6379/0
JWT_ISSUER=karenseir-api
JWT_AUDIENCE=karenseir-web
# M-3: httpOnly cookie session + CSRF (backend/app/auth_cookies.py). Off by default.
# Turn on only after HTTPS works: AUTH_COOKIE_MODE=1 and AUTH_COOKIE_SECURE=1, then restart api.
# (auto = Secure only on HTTPS requests; Bearer API clients keep working either way.)
# AUTH_COOKIE_MODE=0
# AUTH_COOKIE_SECURE=auto
# AUTH_COOKIE_PATH=/
# Optional per-purpose signing keys (M-5). Unset = derived from JWT_SECRET with HKDF, so
# nothing has to change on upgrade. Set each to its own 32+ random characters (or *_FILE) to
# fully decouple them. The compose file must pass any you set through to the api service.
# ACCESS_TOKEN_SECRET=        # access JWTs (unset = JWT_SECRET itself; changing it logs everyone out)
# MFA_TICKET_SECRET=          # 2FA login ticket
# PAYMENT_STATE_SECRET=       # payment callback state
# VOUCHER_QR_SECRET=          # voucher QR codes
# Accept values signed with the old shared key (in-flight payments, printed vouchers).
# Set to 0 once vouchers issued before the upgrade have expired.
# SIGNING_LEGACY_FALLBACK=1
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://karenseir:replace-with-strong-password@db:5432/karenseir
REDIS_URL=redis://redis:6379/0
# Provision separately; never reuse the API role. Required for cross-tenant outbox polling.
WORKER_DATABASE_URL=postgresql+psycopg://karenseir_worker:replace-with-worker-password@db:5432/karenseir
CORS_ORIGINS=https://your-domain.example
NEXT_PUBLIC_API_URL=https://api.your-domain.example
# External integrations remain disabled until authorized secret-manager references exist.
FLIGHT_PROVIDER_MODE=disabled
HOTEL_PROVIDER_MODE=disabled
TOUR_HOTEL_PROVIDER_MODE=disabled
PAYMENT_PROVIDER_MODE=disabled
OTP_PROVIDER_MODE=disabled
# ZarinPal stays disabled unless all three values are supplied through the
# deployment secret/config contract. Never commit a merchant ID.
ZARINPAL_MODE=disabled
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=https://api.your-domain.example/payments/zarinpal/callback
# QA/staging ONLY: local sandbox gateway "درگاه آزمایشی — پرداخت واقعی نیست" (D6).
# Refused (process will not start) unless ENVIRONMENT is development/test/staging.
# PAYMENT_PROVIDER=sandbox
# SANDBOX_PAYMENT_BASE_URL=http://127.0.0.1:8000   # backend origin that serves /payments/sandbox/*
# NEXT_PUBLIC_PAYMENT_SANDBOX=1                     # frontend: allow http loopback sandbox redirect (never in production builds)
# Funded-but-unfulfilled (wallet/org credit) reservations are expired and released after this many minutes (D1).
RESERVATION_FUNDED_HOLD_MINUTES=1440
# VandaPay (ونداپی) — group gateway. disabled | test | live. Fail-closed: without a valid key no payment is started.
# One implementation (ADR-024 + ADR-029): app/vandapay.py. Key prefix must match the mode; sk_live_ only in production.
VANDAPAY_MODE=disabled
VANDAPAY_SECRET_KEY=            # sk_test_… / sk_live_… — server only, never in the frontend (or VANDAPAY_SECRET_KEY_FILE)
VANDAPAY_WEBHOOK_SECRET=        # signs VandaPay-Signature (t=…,v1=…) (or VANDAPAY_WEBHOOK_SECRET_FILE)
VANDAPAY_BASE_URL=              # required, https only, e.g. https://<vandapay-domain>/api/v1 (configuration only, never hard-coded)
VANDAPAY_RETURN_URL=https://karentravel.ir/api/payments/vandapay/return
# VANDAPAY_INTENT_EXPIRES_IN_SECONDS=          # optional (VP-01, 300..259200); empty = VandaPay default TTL
# VANDAPAY_FEDERATED_CREDIT_ORGANIZATION_IDS=  # optional: organizations whose credit is owned by VandaPay's ledger
# Webhook URL to register in the VandaPay merchant panel: https://karentravel.ir/api/payments/vandapay/webhook
# Injast (اینجاست) — second gateway beside VandaPay, customer chooses (ADR-030). disabled | live. Fail-closed.
# Injast whitelists the server IP (188.121.123.218) before go-live; live is refused outside production (no sandbox documented).
INJAST_MODE=disabled
INJAST_MERCHANT_ID=             # UUID issued by Injast for Karen Travel (or INJAST_MERCHANT_ID_FILE); Checkline has its own
INJAST_CALLBACK_URL=https://karentravel.ir/api/payments/injast/callback
# INJAST_API_BASE=https://api.injast.life/service/pay
# INJAST_PAY_BASE=https://pay.injast.life

# Sandbox example (never put the secret itself here):
# PAYMENT_PROVIDER_MODE=sandbox
# PAYMENT_PROVIDER_ENDPOINT=https://sandbox.authorized-provider.example
# PAYMENT_PROVIDER_SECRET_REF=vault://karenseir/payment-sandbox
NOTIFICATION_PROVIDER_MODE=disabled
# Explicitly set true only for a labelled demo deployment; never for a real rollout.
DEMO_MODE=false
SMS_PROVIDER_MODE=disabled
PUSH_PROVIDER_MODE=disabled
EMAIL_PROVIDER_MODE=disabled
SUPPLIER_INVENTORY_PROVIDER_MODE=disabled
VOUCHER_ISSUANCE_PROVIDER_MODE=disabled
# Optional provider-specific distributed throttle (requests/minute):
# FLIGHT_PROVIDER_RATE_LIMIT=60
# Invoice issuance is fail-closed in Production until an approved legal policy is configured.
INVOICE_TAX_BPS=
INVOICE_TAX_POLICY_REFERENCE=
# Mahan Air (W5) MRS flight supplier — disabled | qaa | live (default disabled = no Mahan flights, fail closed).
# qaa = Mahan test system, staff-only; live = production, NOT granted by Mahan yet. Values go in the server env only.
MAHAN_MODE=disabled
# MAHAN_QAA_API_KEY=            (or MAHAN_QAA_API_KEY_B64)
# MAHAN_QAA_OFFICE_USER=
# MAHAN_QAA_OFFICE_PASS=
# MAHAN_API_KEY=                (live; after Mahan grants production access)
# MAHAN_OFFICE_USER=
# MAHAN_OFFICE_PASS=
# MAHAN_TIMEOUT_SECONDS=25
# Niira NRS airlines (one API, many airlines) — off | sandbox | live (default off = no Niira call at all, fail closed).
# sandbox = only Niira's test airline A1 (http://a1.nirasoft.ir), staff-only. live = airlines in NIRA_AIRLINES with credentials.
# Accounts are Tazheban's (owner decision 1405-09-07). Values go in the server env only — never in git. See docs/integrations/NIRA_NRS_WEBSERVICE.md.
NIRA_MODE=off
# NIRA_AIRLINES=                 (comma list, e.g. A1 for sandbox; VR,J1,DZD,HH,PA,ISP,FP for live; aliases VAR/JI/TBN accepted)
# NIRA_A1_USER=
# NIRA_A1_PASS=
# NIRA_VR_USER=                  (per airline: NIRA_<CODE>_USER / NIRA_<CODE>_PASS — the airline's web-service "WS" user)
# NIRA_VR_PASS=
# NIRA_VR_HOST=                  (optional override of the built-in host table; required for W5)
# NIRA_VR_CGI=                   (optional override, e.g. NRSWebWS.cgi)
# NIRA_VR_ROUTES=                (optional route table, e.g. THR-MHD,MHD-THR; when set only these routes are queried)
