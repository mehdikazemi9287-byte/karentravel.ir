+.home-page .fs-tabs button.is-active svg{opacity:1}
+.home-page .fs-more{position:relative;flex:0 0 auto}.home-page .fs-more-menu{position:absolute;z-index:30;top:calc(100% + 4px);right:0;display:grid;min-width:190px;padding:6px;background:var(--fs-surface);border:1px solid var(--fs-border);border-radius:12px;box-shadow:0 12px 30px rgba(18,38,63,.16)}.home-page .fs-more-menu button{width:100%;justify-content:flex-start;border-bottom:0!important}.home-page .fs-unavailable{display:grid;gap:8px;min-height:130px;align-content:center;text-align:center}.home-page .fs-unavailable b{font-size:18px;color:var(--fs-primary)}.home-page .fs-unavailable p{margin:0;color:var(--fs-muted);font-size:14px}
