+.home-page .jalali-target{display:block;color:var(--fs-muted);text-align:center;margin-top:6px}
+
+/* Phase 6: real Assistant integration -- approval / auth-required /
+   reservation-result / result-card surfaces. Reuses existing tokens
+   (--ink/--ocean/--line/.panel/.button/.tag) for visual consistency;
+   no new color system introduced. */
+.home-page .assistant-resume-banner{margin:0 22px 4px;padding:12px 14px;border-radius:12px;background:#eef7f4;color:var(--ink);font-size:13px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between}
+.home-page .assistant-panel{margin:0 22px 14px;padding:16px;font-size:13px}
+.home-page .assistant-panel strong{display:block;font-size:14px;margin-bottom:4px}
+.home-page .assistant-panel p{margin:0 0 8px;color:var(--muted)}
+.home-page .assistant-panel-warn{border-color:#f0c56b;background:#fffaf0}
+.home-page .assistant-panel-error{border-color:#e79a9a;background:#fff5f5}
+.home-page .assistant-panel-ok{border-color:#9bd4c9;background:#f2fbf8}
+.home-page .assistant-panel-actions{display:flex;gap:10px;flex-wrap:wrap}
+.home-page .assistant-inline-actions{margin:0 22px 14px}
+.home-page .assistant-message-error{background:#fff5f5!important;color:#8a2c2c!important}
+.home-page .assistant-results{margin:4px 22px 14px;display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px}
+.home-page .assistant-result-card{padding:14px;display:grid;gap:6px}
+.home-page .assistant-result-card h3{margin:0;font-size:14px}
+.home-page .assistant-result-card p{margin:0;color:var(--muted);font-size:13px}
+@media (max-width:760px){
+  .home-page .assistant-resume-banner,.home-page .assistant-panel,.home-page .assistant-inline-actions,.home-page .assistant-results{margin-left:12px;margin-right:12px}
+}
+
+/* Customer service guidance, using the existing visual palette. */
+.home-page .customer-page{padding-top:48px;padding-bottom:64px;min-height:50vh}.home-page .customer-page h1{font-size:clamp(26px,4vw,40px);margin-bottom:20px}.home-page .customer-page p{line-height:2;max-width:850px}.home-page .customer-actions,.home-page .customer-links,.home-page .customer-categories{display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin:24px 0}.home-page .customer-actions a{overflow-wrap:anywhere}.home-page .customer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:24px;margin:28px 0}.home-page .customer-grid article,.home-page .customer-grid>a,.home-page .customer-notice{padding:24px;border:1px solid var(--line);border-radius:20px;background:#fff}.home-page .customer-grid img,.home-page .customer-page>img{width:100%;height:auto;max-height:420px;object-fit:cover;border-radius:16px}.home-page .customer-page form{display:flex;flex-wrap:wrap;gap:16px;margin:24px 0;align-items:end}.home-page .customer-page input{display:block;padding:12px;border:1px solid var(--line);border-radius:10px;max-width:100%;font:inherit}.home-page .customer-page h2{margin:14px 0}.home-page .customer-links a,.home-page .customer-categories a{text-decoration:underline;text-underline-offset:5px}.home-page .support-path{flex-wrap:wrap}.home-page .support-path p{line-height:1.9}.home-page .support-dock nav{display:flex;flex-wrap:wrap;gap:20px}.home-page .support-dock{margin-top:32px;padding:24px}.home-page .customer-notice{margin:24px 0}@media(max-width:600px){.home-page .customer-page{padding-top:28px}.home-page .customer-actions .button{max-width:100%;font-size:14px}.home-page .customer-grid{grid-template-columns:1fr}}
+
+.home-page .trust-grid article>a{grid-column:1/-1;font-size:11px;border-top:1px solid #f0e6df;padding-top:8px}.home-page .support-paths article.support-path{display:flex;flex-direction:column;align-items:flex-start;gap:12px}.home-page .support-paths article.support-path a{white-space:normal}.home-page .support-dock{position:static;transform:none;margin:32px auto;display:flex;flex-wrap:wrap;max-height:none}.home-page .support-dock nav{font-size:14px}.home-page .support-dock h2{font-size:18px}.home-page .support-dock p{font-size:13px}.home-page .support-dock nav a{text-decoration:underline}.home-page .fs-unavailable .customer-actions a{font-size:13px}.home-page .fs-unavailable{height:auto!important;min-height:110px}.home-page .customer-page .panel{margin-top:24px}
+
+.home-page .journey-page .support-dock{background:#2a1530;color:#fff;border-radius:18px;box-shadow:none}.home-page .support-dock nav a{color:#fff}.home-page .customer-actions .button{gap:8px}
+
+/* Organization request workspace: preserve the existing shell and visual identity. */
+.home-page .enterprise-workspace label { display: block; margin-block: .5rem; }
+.home-page .enterprise-workspace input:not([type="checkbox"]), .home-page .enterprise-workspace select, .home-page .enterprise-workspace textarea { display: block; width: 100%; max-width: 100%; padding: .7rem; border: 1px solid #cbd5e1; border-radius: .6rem; background: white; color: #172033; box-sizing: border-box; }
+.home-page .enterprise-workspace input[type="checkbox"] { margin-inline-end: .5rem; }
+.home-page .enterprise-workspace article { padding-block: 1rem; border-bottom: 1px solid #e2e8f0; }
+.home-page .enterprise-workspace button { margin-block: .5rem; }
